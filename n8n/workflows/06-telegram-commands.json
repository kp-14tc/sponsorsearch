      },
      "id": "run-draft",
      "name": "Draft saved lead",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1760,
        20
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "SELECT_WORKFLOW_05",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "send-status",
      "name": "Send current review queue",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2200,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({json: {...item.json, include_draft: true}}));"
      },
      "id": "include-saved-draft",
      "name": "Include saved draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        20
      ]
    }
