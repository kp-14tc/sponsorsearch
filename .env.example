# Generate unique secrets; do not use these placeholders.
POSTGRES_USER=frc
POSTGRES_PASSWORD=replace-with-random-hex-secret
POSTGRES_DB=frc
N8N_ENCRYPTION_KEY=replace-with-random-hex-secret
SEARXNG_SECRET=replace-with-random-hex-secret
TZ=UTC
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
# Set to 1 after configuring private HTTPS through Tailscale Serve.
N8N_PROXY_HOPS=0
OLLAMA_URL=http://host.docker.internal:11434
SCOUT_MODEL=qwen3.5:4b
RESEARCH_MODEL=qwen3.5:9b
# Email-writer sampling temperature; modest variation without encouraging unsupported creative details.
DRAFT_TEMPERATURE=0.3
# Bounded seconds; maximums are scout 120, research 1200, fetch 60.
SCOUT_TIMEOUT_SECONDS=120
RESEARCH_TIMEOUT_SECONDS=900
FETCH_TIMEOUT_SECONDS=30
# Optional Crawl4AI diagnostics. HTTP extraction remains the pipeline default.
CRAWL4AI_URL=
CRAWL4AI_TOKEN=
# Optional inbound Telegram commands. Keep the token only in .env and n8n's credential store.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
POSTGRES_IMAGE=postgres:16-alpine
N8N_IMAGE=docker.n8n.io/n8nio/n8n:stable
SEARXNG_IMAGE=searxng/searxng:latest
CRAWL4AI_IMAGE=unclecode/crawl4ai:latest
